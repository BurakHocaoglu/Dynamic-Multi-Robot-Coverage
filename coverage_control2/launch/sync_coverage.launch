<?xml version="1.0" encoding="UTF-8"?>

<launch>

	<arg name="count" default="8" />
	<arg name="prefix" default="gdb -ex run --args" />

	<rosparam command="load" file="$(find coverage_control2)/cfg/params.yaml" />

	<node name="synched_monitor" pkg="coverage_control2" type="partitioning.py" args="$(arg count)" output="screen" respawn="false" />

</launch>